{
  "Storage": {
    "DataDirectory": "App_Data",
    "MaxArtifactBytes": 26214400,
    "MaxSnapshotBytes": 67108864,
    "MaxRequestBodyBytes": 100663296,
    "MaxArtifactsPerSnapshot": 128,
    "ExcludeSecureConfiguration": true
  },
  "AnalysisQueue": {
    "Capacity": 32
  },
  "Decompiler": {
    "WorkerPath": "",
    "TempDirectory": "DecompilerTemp",
    "TimeoutSeconds": 60,
    "MaxInputBytes": 26214400,
    "MaxOutputBytes": 8388608,
    "MaxAssembliesPerSnapshot": 8,
    "MaxDiagnosticCharacters": 4096,
    "EagerAnalysis": false
  },
  "AI": {
    "Enabled": true,
    "Provider": "DeepSeek",
    "BaseUrl": "https://api.deepseek.com",
    "Model": "deepseek-v4-pro",
    "TimeoutSeconds": 900,
    "MaxContextTokens": 262144,
    "MaxCompletionTokens": 8192,
    "MaxInvestigationCompletionTokens": 4096,
    "MaxEvidenceCharacters": 180000,
    "MaxInvestigationSeconds": 900,
    "MaxToolResultCharacters": 160000
  },
  "Security": {
    "EnableWindowsAuthentication": true,
    "CorsAllowedOrigins": [],
    "RateLimit": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 4
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
